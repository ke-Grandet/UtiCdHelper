<UserControl x:Class="UtiCdHelper.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <Grid HorizontalAlignment="Center">
                <ItemsControl x:Name="CellList" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- 识图读到的名字。尺寸固定：没记录时留白，
                                     有记录时也不会把格子挤下去；宽度与下面的启动按钮对齐 -->
                                <TextBlock Text="{Binding Name}"
                                           Width="68"
                                           Height="18"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2"
                                           ToolTip="{Binding Name}"
                                           Foreground="{StaticResource MutedForegroundBrush}" />

                                <Border Style="{StaticResource CellStyle}">
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource CellInputStyle}"
                                             MaxLength="3"
                                             ToolTip="直接输入初始秒数（0-999 的整数），等同于识图填入"
                                             PreviewTextInput="OnCellPreviewTextInput" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 负 Margin 让按钮组挂在方格右侧外面，不占据布局宽度，方格保持整体居中；
                     顶部偏移 20（名字行的高度）让整组与方格顶端对齐 -->
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,20,-66,0">
                    <!-- 26 + 4 + 26 = 56，正好等于方格高度：识图上沿、复位下沿与方格上下沿齐平 -->
                    <Button Content="识图"
                            Width="52"
                            Height="26"
                            Padding="0"
                            FontSize="12"
                            ToolTip="识别初始值区域并填入方格"
                            Click="OnPickClick" />

                    <Button Content="复位"
                            Width="52"
                            Height="26"
                            Padding="0"
                            FontSize="12"
                            Margin="0,4,0,0"
                            ToolTip="将五个数字清零并中断所有倒计时"
                            Click="OnResetClick" />
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="StartList" HorizontalAlignment="Center" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Button Content="启动"
                                    Width="56"
                                    Height="26"
                                    Padding="0"
                                    Margin="6,0"
                                    FontSize="12"
                                    ToolTip="启动该路倒计时（已在计时则重新开始）"
                                    Click="OnStartClick" />

                            <Button Content="喊话"
                                    Width="56"
                                    Height="26"
                                    Padding="0"
                                    Margin="6,6,6,0"
                                    FontSize="12"
                                    ToolTip="把该格就绪时刻复制到剪贴板"
                                    Click="OnShoutClick" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 操作反馈：固定高度，避免出现/消失时下面的按钮跳动 -->
            <TextBlock x:Name="StatusText"
                       Height="20"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedForegroundBrush}" />

            <Button Content="快捷键"
                    Width="200"
                    Height="56"
                    FontSize="18"
                    Margin="0,16,0,0"
                    Click="OnHotKeyClick" />

        </StackPanel>

        <!-- 顶部开关：绝对定位，不占布局空间，其它元素的位置不受影响 -->
        <CheckBox x:Name="MirrorBox"
                  Content="镜像悬浮窗横坐标"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,24,0,0"
                  Padding="4,0"
                  FontSize="12"
                  VerticalContentAlignment="Center"
                  Cursor="Hand"
                  Foreground="{StaticResource MutedForegroundBrush}"
                  ToolTip="勾选后悬浮窗实际横坐标 = 配置横坐标相对屏幕中心垂线的镜像位置（不保存，下次启动回到不勾选）"
                  Checked="OnMirrorClick"
                  Unchecked="OnMirrorClick" />

        <!-- 左下角的版本号：与右下角按钮组同侧边距、同一条底线 -->
        <TextBlock x:Name="VersionText"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="24,0,0,18"
                   FontSize="12"
                   Foreground="{StaticResource MutedForegroundBrush}" />

        <!-- 右下角的文本按钮：使用说明、识图设置、调节位置依次向下排 -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,18">
            <Button Content="使用说明"
                    HorizontalAlignment="Right"
                    Padding="8,4"
                    Style="{StaticResource LinkButtonStyle}"
                    Click="OnHelpClick" />

            <Button Content="识图设置"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Padding="8,4"
                    Style="{StaticResource LinkButtonStyle}"
                    Click="OnRecognitionClick" />

            <Button Content="调节位置"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Padding="8,4"
                    Style="{StaticResource LinkButtonStyle}"
                    Click="OnPositionClick" />
        </StackPanel>
    </Grid>
</UserControl>
