<UserControl x:Class="UtiCdHelper.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="主界面"
                           Style="{StaticResource HelpHeadingStyle}" />
                <TextBlock Style="{StaticResource HelpBodyStyle}">
                    · 五个方格：填技能的冷却秒数（0-999），点一下就能改。<LineBreak />
                    · 方格上方：技能名字，识图后自动填上。<LineBreak />
                    · 启动：开始这一格的倒计时，再点一次重新开始。<LineBreak />
                    · 喊话：把“什么时候就绪”复制到剪贴板，粘到聊天里发出去。<LineBreak />
                    · 识图：读屏幕上的数字和名字，弹窗里点一格填入。<LineBreak />
                    · 复位：清空所有数字和名字，并停掉所有倒计时。<LineBreak />
                    · 快捷键、识图设置、调节位置：进入对应的设置界面。<LineBreak />
                    · 底部灰字：显示上一步操作的结果。
                </TextBlock>

                <TextBlock Text="圆点界面"
                           Style="{StaticResource HelpHeadingStyle}" />
                <TextBlock Style="{StaticResource HelpBodyStyle}">
                    · 屏幕顶部一排五个圆点，和五个方格一一对应。<LineBreak />
                    · 绿色：没在计时，不显示数字。<LineBreak />
                    · 蓝色：正在倒计时，显示剩余秒数。<LineBreak />
                    · 圆点跟着游戏里的时钟走：游戏暂停它也停，最小化时同样暂停。<LineBreak />
                    · 鼠标划过去会变淡，不会挡操作。
                </TextBlock>

                <TextBlock Text="识图设置"
                           Style="{StaticResource HelpHeadingStyle}" />
                <TextBlock Style="{StaticResource HelpBodyStyle}">
                    · 三块区域：名字（汉字）、初始值（秒数）、计时（时刻）。<LineBreak />
                    · 每块都能框选位置、调下面三个参数，并用“测试”当场看效果。<LineBreak />
                    <LineBreak />
                    · 放大（1-8）：把截图放大几倍再交给识别。字小看不清时调到 4 或 5；字够大就用 1-3，调太大只会变慢。<LineBreak />
                    · 阈值（0-255，填 -1 为自动）：区分“字”和“背景”的亮度界线。默认自动就够；背景花、自动认错时改成 128 或 160 再试。<LineBreak />
                    · 反色（开/关）：把字和背景的黑白对调。亮字配深底时打开；深字配亮底时保持关闭。
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="返回"
                Width="120"
                Height="36"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Click="OnBackClick" />

    </Grid>
</UserControl>
