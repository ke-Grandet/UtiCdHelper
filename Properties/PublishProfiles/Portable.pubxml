<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- 用法：dotnet publish -p:PublishProfile=Portable
         产出免安装目录（自带 .NET 运行时，拷到哪儿都能跑）。
         注意：不能用 PublishSingleFile —— Tesseract 的原生库加载依赖 Assembly.Location，
         单文件模式下它是空串，初始化时会抛 ArgumentNullException 直接崩。 -->
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\Portable\</PublishDir>
  </PropertyGroup>
</Project>
