<UserControl x:Class="UtiCdHelper.RecognitionAreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <Border x:Name="Separator"
                Height="1"
                Background="{StaticResource NormalBorderBrush}"
                Margin="0,20,0,14"
                Visibility="Collapsed" />

        <Grid Margin="0,8" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="0"
                       x:Name="TitleText"
                       FontSize="14"
                       Width="120"
                       VerticalAlignment="Top" />

            <!-- 数字配置：区域坐标 -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="X" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedForegroundBrush}" />
                <TextBox x:Name="BoxX" Width="64" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Text="Y" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedForegroundBrush}" />
                <TextBox x:Name="BoxY" Width="64" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Text="宽" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedForegroundBrush}" />
                <TextBox x:Name="BoxWidth" Width="64" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Text="高" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedForegroundBrush}" />
                <TextBox x:Name="BoxHeight" Width="64" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            </StackPanel>

            <!-- 数字配置：预处理参数 -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="放大" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedForegroundBrush}" />
                <TextBox x:Name="BoxScale" Width="64" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="1-8，小字建议 3-5" />

                <TextBlock Text="阈值" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedForegroundBrush}" />
                <TextBox x:Name="BoxThreshold" Width="64" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="-1 为自动，否则 0-255" />

                <Button x:Name="InvertButton"
                        Content="反色：关"
                        Width="76"
                        Height="32"
                        FontSize="12"
                        Padding="0"
                        Margin="12,0,0,0"
                        ToolTip="字被当成背景时打开"
                        Click="OnInvertClick" />
            </StackPanel>

            <!-- 分隔竖线：只分隔配置项和功能按钮 -->
            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Width="1"
                    Background="{StaticResource NormalBorderBrush}"
                    VerticalAlignment="Stretch"
                    Margin="18,0" />

            <!-- 功能按钮：框选在上，测试在下 -->
            <StackPanel Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="3"
                        VerticalAlignment="Top">
                <Button Content="框选"
                        Width="70"
                        Height="32"
                        FontSize="12"
                        Padding="0"
                        ToolTip="在屏幕上框选识别区域"
                        Click="OnSelectRegionClick" />

                <Button Content="测试"
                        Width="70"
                        Height="32"
                        FontSize="12"
                        Padding="0"
                        Margin="0,10,0,0"
                        ToolTip="按当前参数识别一次"
                        Click="OnTestClick" />
            </StackPanel>

            <!-- 测试信息独立成行，横贯配置项与功能按钮 -->
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       x:Name="ResultText"
                       Margin="0,12,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedForegroundBrush}" />

        </Grid>
    </StackPanel>
</UserControl>
